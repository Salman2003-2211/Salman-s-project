{
  "name": "spare-functions",
  "version": "1.0.0",
  "description": "Secure Cloud Functions for S.P.A.RE AI Studio and Gemini API services",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google/genai": "^0.1.1",
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "private": true
}
